{
  "compilerOptions": {
    "target": "es2019", // Or a more modern target
    "lib": [
      "dom",
      "dom.iterable"
    ], // Removed esnext, adjust as needed.
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": false, // Change this when building for production
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve", // Consider changing to react-jsx or react-jsxdev
    "incremental": true // Consider false for CI/CD
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules"
  ]
}
