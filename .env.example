# This is a template for environment variables
# Copy this file to the following locations and update values:
#
# For backend:         ./backend/.env
# For frontend:        ./frontend/.env
# For docker-compose:  ./.env
# For local dev:       ./.env.local
#
# NEVER commit actual .env files to git!

# Database Configuration
DB_HOST=localhost          # Use 'db' for docker-compose
DB_PORT=5432
DB_USER=your_username
DB_PASSWORD=your_password
DB_NAME=foodapp
# Full database URL (used by some components)
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# Server Configuration
PORT=8080                  # Backend API port
ENVIRONMENT=development    # development, staging, production

# Security
JWT_SECRET=your-jwt-secret-here

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8080  # Backend API URL for frontend
NEXT_PUBLIC_APP_ENV=development            # Frontend environment

# Docker Configuration
DOCKER_REGISTRY=your-registry              # For production deployments
IMAGE_TAG=latest                           # Docker image tag

# Additional Services (if needed)
REDIS_URL=redis://localhost:6379
FIREBASE_CONFIG=your-firebase-config

# Note: 
# - Development: Use individual .env files in each directory
# - Docker: Use root .env for docker-compose
# - Production: Use Kubernetes secrets and configmaps
